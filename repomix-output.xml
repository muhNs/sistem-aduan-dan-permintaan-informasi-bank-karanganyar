 [id])\n\n  infoDetail     String  @db.LongText\n  purpose        String?\n  infoMethod     String?\n  deliveryMethod String?\n\n  status          RequestStatus @default(pending)\n  responseDueDate DateTime?\n\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n  deletedAt DateTime?\n\n  // relations\n  response    InformationRequestResponse?\n  attachments Attachment[]\n}\n\n// RESPONSE PERMOHONAN (1:1)\n\nmodel InformationRequestResponse {\n  id Int @id @default(autoincrement())\n\n  requestId Int                @unique\n  request   InformationRequest @relation(fields: [requestId], references: [id])\n\n  responseMessage String @db.LongText\n\n  respondedBy Int\n  user        User @relation(fields: [respondedBy], references: [id])\n\n  respondedAt DateTime?\n  emailSentAt DateTime?\n\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n  deletedAt DateTime?\n}\n\n// ADUAN\n\nmodel Complaint {\n  id         Int    @id @default(autoincrement())\n  ticketCode String @unique // COM-2026-0001\n\n  nasabahId Int\n  nasabah   Nasabah @relation(fields: [nasabahId], references: [id])\n\n  category    ComplaintCategory\n  description String            @db.LongText\n\n  status   ComplaintStatus @default(open)\n  priority PriorityLevel   @default(medium)\n\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n  deletedAt DateTime?\n\n  // relations\n  resolution  ComplaintResolution?\n  attachments Attachment[]\n}\n\n// RESOLUTION ADUAN (1:1)\n\nmodel ComplaintResolution {\n  id Int @id @default(autoincrement())\n\n  complaintId Int       @unique\n  complaint   Complaint @relation(fields: [complaintId], references: [id])\n\n  resolutionMessage String @db.LongText\n\n  resolvedBy Int\n  user       User @relation(fields: [resolvedBy], references: [id])\n\n  resolvedAt  DateTime?\n  emailSentAt DateTime?\n\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n  deletedAt DateTime?\n\n  attachments Attachment[]\n}\n\nmodel TicketSequence {\n  id        Int    @id @default(autoincrement())\n  type      String // 'REQ' atau 'COM'\n  year      Int // 2026\n  lastValue Int    @default(0)\n\n  // Kombinasi type dan year harus unik agar kita bisa melakukan upsert\n  @@unique([type, year])\n}\n\n// ATTACHMENTS\n\nmodel Attachment {\n  id Int @id @default(autoincrement())\n\n  requestId             Int?\n  complaintId           Int?\n  complaintResolutionId Int? // <--- TAMBAHKAN INI\n\n  request   InformationRequest? @relation(fields: [requestId], references: [id])\n  complaint Complaint?          @relation(fields: [complaintId], references: [id])\n\n  // TAMBAHKAN RELASI INI\n  resolution ComplaintResolution? @relation(fields: [complaintResolutionId], references: [id])\n\n  filePath String\n\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n  deletedAt DateTime?\n}\n",
  "runtimeDataModel": {
    "models": {},
    "enums": {},
    "types": {}
  },
  "parameterizationSchema": {
    "strings": [],
    "graph": ""
  }
