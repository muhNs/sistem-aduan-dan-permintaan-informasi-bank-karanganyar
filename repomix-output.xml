  uploadedAt: string; // Format ISO: "2026-04-30T00:00:00.000Z"
}

export interface Resolution {
  id: number;
  resolutionMessage: string;
  resolvedBy: {
    id: number;
    name: string;
  };
  resolvedAt: string; // Format ISO: "2026-04-30T00:00:00.000Z"
}

export interface Aduan {
  id: number;
